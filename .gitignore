# Entorno Python
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*$py.class
*.egg-info/
.eggs/
dist-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build temporal de PyInstaller (el .exe distribuible sí se versiona)
build/

# Datos que genera el .exe si se ejecuta desde dist/
dist/ConsolidadoHumanidades/datos/*.db
dist/ConsolidadoHumanidades/datos/*.db-journal
dist/ConsolidadoHumanidades/datos/entrada/*.xlsx
dist/ConsolidadoHumanidades/datos/historico/
dist/ConsolidadoHumanidades/salida/*.xlsx
dist/ConsolidadoHumanidades/salida/*.xls
dist/ConsolidadoHumanidades/salida/*.xlsm

# ZIP de distribución: se versiona ConsolidadoHumanidades-Windows.zip
# (sin Git LFS, para que «Download ZIP» del repo lo traiga de verdad)
release/*
!release/.gitkeep
!release/README.md
!release/ConsolidadoHumanidades-Windows.zip

# Paquete de Excels de prueba (raíz). GitHub admite hasta 100 MB por archivo.
!ArchivosPrueba2026-1.zip

# Residuos locales
installed.txt

# Excel: datos de entrada, salidas y ejemplos locales
*.xlsx
*.xls
*.xlsm
*.xlsb
~$*.xlsx
~$*.xls
~$*.xlsm

# Carpetas de datos generados (mantener solo .gitkeep)
datos/entrada/*
!datos/entrada/.gitkeep
datos/historico/
datos/*.db
datos/*.db-journal
salida/*
!salida/.gitkeep
Ejemplos/*
!Ejemplos/.gitkeep

# IDE / sistema
.idea/
.vscode/
.cursor/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# Logs y temporales
*.log
*.tmp
