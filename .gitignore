# Entorno Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build del ejecutable (no subir a GitHub; generar localmente con build_exe.bat)
build/
dist/

# Excel: datos de entrada, salidas y ejemplos locales
*.xlsx
*.xls
*.xlsm
*.xlsb
~$*.xlsx
~$*.xls
~$*.xlsm

# Carpetas de datos generados (mantener solo .gitkeep)
datos/entrada/*
!datos/entrada/.gitkeep
salida/*
!salida/.gitkeep
Ejemplos/*
!Ejemplos/.gitkeep

# IDE / sistema
.idea/
.vscode/
.cursor/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# Logs y temporales
*.log
*.tmp
*.temp
