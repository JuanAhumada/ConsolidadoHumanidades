* text=auto
*.py text eol=lf
*.bat text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.plist text eol=lf

# Lanzador pequeño (no LFS): debe viajar como binario en el ZIP del código
/ConsolidadoHumanidades.exe binary
empaque/Lanzador.exe binary
ArchivosPrueba2026-1.zip binary

# Paquete Windows (>100 MB): GitHub no admite este tamaño en git normal
release/ConsolidadoHumanidades-Windows.zip filter=lfs diff=lfs merge=lfs -text

# GitHub Desktop mide el archivo en disco aunque se esté borrando de git.
# Con LFS deja de bloquear el commit; dist/ sigue ignorado y no se vuelve a subir.
dist/**/*.pyd filter=lfs diff=lfs merge=lfs -text
